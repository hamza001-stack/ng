{
  "name": "nevie-global-uk",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "prisma generate && node scripts/db-sync.mjs --build && next build",
    "start": "node scripts/db-sync.mjs --seed && next start -H 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "tsx --test tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:sync": "node scripts/db-sync.mjs --seed",
    "db:seed": "tsx prisma/seed.ts",
    "db:content": "tsx prisma/content.ts",
    "admin:reset-2fa": "tsx prisma/reset-2fa.ts",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.0",
    "@prisma/client": "^6.16.2",
    "@radix-ui/react-slot": "^1.2.0",
    "@sentry/nextjs": "^10.12.0",
    "@swc/helpers": "^0.5.23",
    "@tanstack/react-query": "^5.85.0",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.3.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "ioredis": "^5.8.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.468.0",
    "motion": "^13.3.0",
    "next": "^15.5.24",
    "next-intl": "^4.0.0",
    "nodemailer": "^10.0.11",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "stripe": "^18.5.0",
    "tailwind-merge": "^3.3.0",
    "@tailwindcss/postcss": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.24",
    "lighthouse": "^13.4.1",
    "prettier": "^3.6.0",
    "prisma": "^6.16.2",
    "sharp": "^0.35.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.4"
  }
}
