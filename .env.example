DATABASE_URL=postgresql://nevie:nevie@127.0.0.1:5433/nevie
REDIS_URL=redis://127.0.0.1:6380
BETTER_AUTH_SECRET=replace-with-32-plus-character-secret
BETTER_AUTH_URL=http://127.0.0.1:3100
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100
# Secret admin console path, e.g. console-<random>. Required in production; /admin returns 404.
ADMIN_PATH=
# Optional. Encrypts Stripe/SMTP secrets saved from admin. Defaults to BETTER_AUTH_SECRET.
SETTINGS_ENCRYPTION_KEY=

# SMTP (fallback; can be set from Admin > Settings)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=NEVIE-GLOBAL UK <support.uk@nevie-global.com>
FORM_NOTIFY_EMAILS=contact@nevie-global.com,emmanuel.varinot@nevie-global.com
REQUIRE_EMAIL_VERIFICATION=false

# Stripe (fallback; test/live keys and mode can be set from Admin > Settings)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
VAT_RATE_BPS=2000
SHIPPING_PENCE=0
LEGAL_COMPANY_NAME=NEVIE-GLOBAL UK
LEGAL_COMPANY_NUMBER=
LEGAL_VAT_NUMBER=
LEGAL_REGISTERED_OFFICE=
LEGAL_ICO_NUMBER=
LEGAL_CONTACT_EMAIL=contact@nevie-global.com
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_PUBLIC_STATIC_PREVIEW=false

# Optional public contact links (sticky CTA / Book Call). Leave empty to hide WhatsApp and route Book Call to the quote form.
NEXT_PUBLIC_BOOKING_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=
